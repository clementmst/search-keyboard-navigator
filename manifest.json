{
  "manifest_version": 3,
  "name": "Search Keyboard Navigator - Private Test",
  "version": "0.1.0",
  "description": "Private-test keyboard navigation for a narrowly supported Google Search results layout.",
  "content_scripts": [
    {
      "matches": [
        "https://www.google.com/search*"
      ],
      "js": [
        "src/policy.js",
        "src/result-policy.js",
        "src/layout-adapter.js",
        "src/navigator.js"
      ],
      "css": [
        "src/navigator.css"
      ],
      "run_at": "document_idle",
      "all_frames": false,
      "world": "ISOLATED"
    }
  ]
}
