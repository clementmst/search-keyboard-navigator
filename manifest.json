{
  "manifest_version": 3,
  "name": "Search Keyboard Navigator - Stage 1A Experiment",
  "version": "0.0.1",
  "description": "Disposable fixture-first experiment for keyboard navigation of supported Google Search result layouts.",
  "content_scripts": [
    {
      "matches": [
        "https://www.google.com/search*"
      ],
      "js": [
        "src/policy.js",
        "src/result-policy.js",
        "src/navigator.js"
      ],
      "css": [
        "src/navigator.css"
      ],
      "run_at": "document_idle",
      "all_frames": false,
      "world": "ISOLATED"
    }
  ]
}
